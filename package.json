{
  "name": "orquestador",
  "version": "0.1.0",
  "description": "Orquestador IA 101: academia para aprender a orquestar IA, desarrollo y UX/UI",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply orquestador --local",
    "db:migrate:remote": "wrangler d1 migrations apply orquestador --remote",
    "cf-typegen": "wrangler types"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "hono": "^4.13.22",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/workers-types": "^5.20261125.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.168.0"
  },
  "private": true,
  "type": "module"
}