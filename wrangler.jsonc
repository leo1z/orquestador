{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orquestador",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    // La SPA de React. /api/* siempre pasa primero por el Worker (Hono).
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orquestador",
      // Base creada el 25 nov 2026 en la cuenta de Leo (región ENAM). Tablas de 0001_init.sql ya aplicadas.
      "database_id": "589b54af-5106-4082-8ace-fc2ca94b07da",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
